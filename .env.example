# ── Gemini Web OpenAI Proxy — copy to .env and adjust ──────────────────────
# Cookie values: gemini.google.com → F12 → Network → any request → Request Cookies
#
# Option A (recommended): 1PSID pair
GWOP_GEMINI_1PSID=__Secure-1PSID_value_here
GWOP_GEMINI_1PSIDTS=__Secure-1PSIDTS_value_here

# Option B: raw cookie header (also picks up 1PSIDCC etc.)
# GWOP_GEMINI_COOKIES_RAW=__Secure-1PSID=...; __Secure-1PSIDTS=...; __Secure-1PSIDCC=...

# Option C: Netscape-format cookies.txt (from a cookie export extension)
# GWOP_COOKIE_FILE=/path/to/cookies.txt

# ── Server ─────────────────────────────────────────────────────────────────
GWOP_HOST=127.0.0.1          # bind 0.0.0.0 only if you must; keep the port private
GWOP_PORT=8011
GWOP_LOG_LEVEL=INFO          # DEBUG | INFO | WARNING | ERROR

# Optional: require Authorization: Bearer <key> on model traffic
# GWOP_API_KEY=please-change-me

# Optional: route upstream traffic through a local HTTP proxy
# GWOP_HTTP_PROXY=http://127.0.0.1:7897

# Auto-refreshed cookies are cached under this directory (persist across restarts)
GWOP_DATA_DIR=./data

# ── Behaviour (defaults are fine) ──────────────────────────────────────────
GWOP_MAX_CONCURRENCY=3           # parallel upstream calls
GWOP_SESSION_CACHE_SIZE=256     # remembered conversations
GWOP_TEMPORARY_CHATS=1           # 0 = keep chats in your Gemini history
GWOP_STRICT_MODEL=0              # 1 = unknown model names are rejected (400)
GWOP_IMAGES_IN_CHAT=1            # append generated-image markdown to replies
GWOP_INCLUDE_THOUGHTS=1          # expose thoughts as reasoning_content
GWOP_REQUEST_TIMEOUT=300
GWOP_INIT_TIMEOUT=120

# Self-healing: when Google reports the session unauthenticated, the proxy
# tries to rotate __Secure-1PSIDTS from the long-lived 1PSID and rebuild the
# client in the background. Rotation is refused for already-expired pairs —
# after MAX_ATTEMPTS failed rounds it goes dormant until POST /admin/reinit.
# GWOP_AUTO_RECOVERY=1
# GWOP_RECOVERY_INTERVAL=60       # seconds between recovery checks
# GWOP_RECOVERY_MAX_ATTEMPTS=5    # failed rounds in a row -> dormant
